    "    save_path=f'{SHAP_FUSION_DIR}/m5_modality_importance.png'\n",
    ")\n",
    "plt.show()\n",
    "\n",
    "# Individual patient explanation\n",
    "fusion_shap.plot_decision(\n",
    "    X_single=X_ftest_sample[m5_probs[:len(X_ftest_sample)].argmax()],\n",
    "    save_path=f'{SHAP_FUSION_DIR}/m5_patient_explanation.png'\n",
    ")\n",
    "plt.show()\n",
    "print('Fusion SHAP figures saved.')"

   "source": [
    "# ─── SHAP on Fusion Layer ────────────────────────────────────────────────────\n",
    "from src.xai.shap_explainer import FusionSHAPExplainer\n",
    "\n",
    "# Build numpy predict function for KernelExplainer\n",
    "m5_model.eval()\n",
    "def fusion_predict_np(X_np):\n",
    "    with torch.no_grad():\n",
    "        X_t = torch.tensor(X_np, dtype=torch.float32).to(device)\n",
    "        return m5_model.predict_proba(X_t).cpu().numpy()\n",
    "\n",
    "SHAP_FUSION_DIR = f'{BASE_DIR}/outputs/figures/m5_shap'\n",
    "os.makedirs(SHAP_FUSION_DIR, exist_ok=True)\n",
    "\n",
    "fusion_shap = FusionSHAPExplainer(\n",
    "    predict_fn      = fusion_predict_np,\n",
    "    background_data = X_ftrain,\n",
    "    modality_names  = M5['modalities'],\n",
    "    n_background    = 50\n",
    ")\n",
    "print('Fusion SHAP explainer ready.')"
   ]
